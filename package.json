{
  "name": "wpi-planner-v2",
  "version": "1.0.0",
  "description": "Modern WPI course planner built with TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "bun run generate-icons && vite build",
    "preview": "vite preview",
    "convert": "bun run scripts/convert-course-data.ts",
    "generate-icons": "bun run scripts/generate-icon-paths.ts",
    "test": "bun test",
    "test:run": "bun test",
    "test:coverage": "bun test --coverage",
    "fetch-data": "bun run scripts/fetch-course-data.ts",
    "fetch-rmp-data": "bun run scripts/rateMyProfessor/fetchRateMyProfessor.ts",
    "merge-to-master": "bash scripts/merge-to-master.sh"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^16.6.0",
    "@testing-library/dom": "^10.4.1",
    "@types/bun": "^1.2.10",
    "typescript": "^5.0.0",
    "vite": "^7.2.7"
  },
  "keywords": [
    "wpi",
    "planner",
    "course",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-browser": "^4.26.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "ical-generator": "^10.0.0",
    "lz-string": "^1.5.0",
    "rrule": "^2.8.1",
    "zod": "^4.1.13"
  }
}
