{
  "name": "wpi-planner-v2",
  "version": "1.0.0",
  "description": "Modern WPI course planner built with TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:converter && vite build",
    "build:converter": "tsc -p tsconfig.converter.json",
    "convert": "node dist/scripts/convert-course-data.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fetch-rmp-data": "tsx scripts/rateMyProfessor/fetchRateMyProfessor.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-legacy": "^5.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "wpi",
    "planner",
    "course",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
