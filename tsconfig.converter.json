{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist/scripts",
    "rootDir": "./scripts",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules", "dist", "src", "tests"]
}
