{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@types/bun"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "*.config.*",
    "server.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/e2e/_*.spec.ts"]
}
