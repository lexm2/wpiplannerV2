# syntax=docker/dockerfile:1.7
FROM oven/bun:1-alpine

RUN apk add --no-cache bash coreutils

WORKDIR /app

# No bun install: the fetch and convert scripts only use Bun's built-in
# modules, and package.json is here just for its `bun run` scripts.
COPY package.json ./

COPY tsconfig.json ./
COPY scripts ./scripts
COPY public ./public

COPY docker/refresh-loop.sh /usr/local/bin/refresh-loop.sh
RUN chmod +x /usr/local/bin/refresh-loop.sh

ENV DATA_DIR=/data \
    REFRESH_INTERVAL_SECONDS=900

CMD ["/usr/local/bin/refresh-loop.sh"]
