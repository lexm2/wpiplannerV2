[Unit]
Description=WPI Planner course data refresh
Wants=network-online.target
After=network-online.target

[Service]
User=wpiplanner
# Bun lives in /usr/local/bin, which systemd's default PATH may lack.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=APP_DIR=/opt/wpiplanner
Environment=DATA_DIR=/var/www/wpiplanner-data
Environment=REFRESH_INTERVAL_SECONDS=900
# Via bash: git stores the script without its executable bit.
ExecStart=/bin/bash /opt/wpiplanner/hosting/scripts/refresh-loop.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
