{
  "name": "High Contrast",
  "id": "high-contrast",
  "description": "Accessibility-focused high contrast theme",
  "colors": {
    "primary": "#000000",
    "primaryHover": "#333333",
    "primaryLight": "#666666",
    "primaryBackground": "rgba(0, 0, 0, 0.05)",
    "primaryRgb": "0, 0, 0",
    "secondary": "#ffffff",
    "secondaryHover": "#f0f0f0",
    "background": "#ffffff",
    "backgroundAlt": "#f8f8f8",
    "surface": "#ffffff",
    "surfaceHover": "#f0f0f0",
    "surfaceElevated": "#eeeeee",
    "text": "#000000",
    "textSecondary": "#444444",
    "textInverse": "#ffffff",
    "border": "#000000",
    "borderHover": "#333333",
    "success": "#006600",
    "successBackground": "rgba(0, 102, 0, 0.1)",
    "warning": "#cc6600",
    "warningBackground": "rgba(204, 102, 0, 0.15)",
    "error": "#cc0000",
    "danger": "#cc0000",
    "dangerHover": "#990000",
    "dangerBackground": "rgba(204, 0, 0, 0.1)",
    "info": "#0066cc",
    "gradientStart": "rgba(0, 0, 0, 0.08)",
    "gradientEnd": "rgba(0, 0, 0, 0.18)"
  },
  "spacing": {
    "baseUnit": "1rem",
    "headerHeight": "64px"
  },
  "effects": {
    "borderRadius": "2px",
    "borderRadiusLarge": "4px",
    "shadow": "0 0 0 2px #000000",
    "shadowHover": "0 0 0 3px #000000",
    "shadowLarge": "0 0 0 3px #000000",
    "transition": "all 0.1s ease"
  }
}
